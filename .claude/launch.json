{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sugan-api",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "SUGAN_MODEL=facebook/nllb-200-distilled-600M",
        "PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.0",
        "./venv/bin/uvicorn",
        "api.server:app",
        "--host",
        "127.0.0.1",
        "--port",
        "10100"
      ],
      "port": 10100
    },
    {
      "name": "sugaan-website",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "website",
        "run",
        "dev",
        "--",
        "--port",
        "4321"
      ],
      "port": 4321
    }
  ]
}