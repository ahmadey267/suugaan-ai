---
interface Props {
  heading: string;
  headingId: string;
  intro?: string;
}
const { heading, headingId, intro } = Astro.props;
---

<div class="grid gap-6 lg:grid-cols-12 lg:gap-x-10">
  <h2 id={headingId} class="text-h2 text-ink lg:col-span-7">{heading}</h2>
  {intro && <p class="max-w-[38rem] text-lead text-ink-2 lg:col-span-5 lg:pt-3">{intro}</p>}
</div>
