---
interface Props {
  eyebrow: string;
  heading: string;
  headingId: string;
  intro?: string;
  index?: string;
}
const { eyebrow, heading, headingId, intro, index } = Astro.props;
// First sentence bright, the rest dimmed.
const [first, ...rest] = heading.split(/(?<=\.)\s+/);
---

<div class="grid gap-6 lg:grid-cols-12 lg:gap-x-8" data-reveal>
  <p class="eyebrow flex gap-3 text-muted lg:col-span-3 lg:pt-3">
    {index && <span class="text-gold">{index}</span>}
    <span>{eyebrow}</span>
  </p>
  <div class="lg:col-span-9">
    <h2 id={headingId} class="mono-heading max-w-[24ch] text-h2 text-fg">
      {first}
      {rest.length > 0 && <span class="text-dim"> {rest.join(' ')}</span>}
    </h2>
    {intro && <p class="mt-6 max-w-[56ch] text-lead text-fg-2">{intro}</p>}
  </div>
</div>
