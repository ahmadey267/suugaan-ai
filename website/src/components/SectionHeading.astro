---
interface Props {
  eyebrow: string;
  heading: string;
  headingId: string;
  dark?: boolean;
  wide?: boolean;
}
const { eyebrow, heading, headingId, dark = false, wide = false } = Astro.props;
---

<div data-reveal>
  <p class:list={['eyebrow', dark ? 'text-gold' : 'text-gold-ink']}>{eyebrow}</p>
  <h2
    id={headingId}
    class:list={[
      'mt-5 font-light',
      wide ? 'max-w-[22ch] text-h2-lg' : 'max-w-[16ch] text-h2',
      dark ? 'text-on-dark' : 'text-ink',
    ]}
  >
    {heading}
  </h2>
</div>
