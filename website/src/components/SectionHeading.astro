---
interface Props {
  index: number;
  eyebrow: string;
  heading: string;
  headingId: string;
  dark?: boolean;
}
const { index, eyebrow, heading, headingId, dark = false } = Astro.props;
const num = String(index).padStart(2, '0');
---

<div data-reveal>
  <span class="block h-px w-6 bg-gold" aria-hidden="true"></span>
  <p class:list={['eyebrow mt-3', dark ? 'text-on-dark-muted' : 'text-muted']}>
    <span aria-hidden="true">{num}&nbsp;&nbsp;</span>{eyebrow}
  </p>
  <h2
    id={headingId}
    class:list={['mt-6 max-w-[18ch] text-h2 font-light', dark ? 'text-on-dark' : 'text-ink']}
  >
    {heading}
  </h2>
</div>
