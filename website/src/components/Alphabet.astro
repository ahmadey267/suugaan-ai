---
/**
 * Specimen of the Somali Latin alphabet with each letter's sound in IPA.
 * Standard orthography order: 21 consonants, then 5 vowels.
 */
interface Props {
  label: string;
  caption: string;
}
const { label, caption } = Astro.props;
const consonants: [string, string][] = [
  ['b', 'b'], ['t', 't'], ['j', 'dʒ'], ['x', 'ħ'], ['kh', 'χ'], ['d', 'd'], ['r', 'r'],
  ['s', 's'], ['sh', 'ʃ'], ['dh', 'ɖ'], ['c', 'ʕ'], ['g', 'ɡ'], ['f', 'f'], ['q', 'q'],
  ['k', 'k'], ['l', 'l'], ['m', 'm'], ['n', 'n'], ['w', 'w'], ['h', 'h'], ['y', 'j'],
];
const vowels: [string, string][] = [['a', 'a'], ['e', 'e'], ['i', 'i'], ['o', 'o'], ['u', 'u']];
// Letters for sounds English does not have: pharyngeals, retroflex, uvulars.
const distinct = new Set(['x', 'c', 'dh', 'q', 'kh']);
const cells = [
  ...consonants.map(([l, ipa]) => ({ l, ipa, kind: distinct.has(l) ? 'distinct' : 'consonant' })),
  ...vowels.map(([l, ipa]) => ({ l, ipa, kind: 'vowel' })),
];
---

<figure class="alphabet" aria-label={label}>
  <ol class="grid grid-cols-7 border-t border-l border-line" aria-hidden="true">
    {
      cells.map((cell, i) => (
        <li
          class:list={[
            'alpha-cell relative flex aspect-square flex-col justify-between border-r border-b border-line p-1.5 sm:p-2.5',
            cell.kind === 'vowel' && 'bg-surface-2',
          ]}
          style={`--i:${i}`}
        >
          <span
            class:list={[
              'text-[clamp(1.25rem,0.6rem+2.6vw,2.25rem)] leading-none font-light tracking-[-0.02em]',
              cell.kind === 'distinct' ? 'text-gold' : 'text-fg',
            ]}
          >
            {cell.l}
          </span>
          <span class="self-end font-mono text-[0.625rem] leading-none text-muted sm:text-[0.6875rem]">
            /{cell.ipa}/
          </span>
        </li>
      ))
    }
    <li class="border-r border-b border-line" />
    <li class="border-r border-b border-line" />
  </ol>
  <figcaption class="mt-4 text-small text-muted">{caption}</figcaption>
</figure>
