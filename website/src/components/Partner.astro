---
import type { SiteContent } from '../content/site';
import Arrow from './Arrow.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
const [first, ...rest] = c.partner.heading.split(/(?<=\.)\s+/);
---

<section id="partner" aria-labelledby="partner-heading" class="relative section-pad">
      <div class="aura-field" aria-hidden="true">
        <div class="aura aura-blue aura-drift top-[-180px] left-[-120px] h-[520px] w-[620px] opacity-60!"></div>
        <div class="aura aura-lilac aura-drift-2 top-[20%] right-[-160px] h-[560px] w-[620px] opacity-70!"></div>
        <div class="aura aura-gold aura-drift bottom-[-220px] left-[30%] h-[520px] w-[700px] opacity-75!"></div>
      </div>
  <div class="container-page relative">
    <!-- Gradient panel: the brand light at full strength, with glass on top -->
    <div class="relative" data-reveal>

      <div class="relative">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-x-8">
          <div class="lg:col-span-7">
            <p class="chip">
              {c.partner.eyebrow}
            </p>
            <h2 id="partner-heading" class="display mt-6 text-h2 text-fg">
              {first}{rest.length > 0 && <span class="text-fg-2"> {rest.join(' ')}</span>}
            </h2>
          </div>
          <p class="max-w-[40ch] text-lead text-fg lg:col-span-5 lg:pb-2">{c.partner.body}</p>
        </div>

        <!-- Choosing an audience preselects the matching "I am a" option in the form below. -->
        <ul class="mt-12 grid gap-3 sm:grid-cols-2 lg:mt-16">
          {
            c.partner.audiences.map((a) => (
              <li>
                <a href={c.partner.cta.href} data-role={a.role} class="glass glass-hover group flex h-full flex-col p-5 sm:p-6">
                  <span class="flex items-start justify-between gap-4">
                    <h3 class="display text-[1.5rem] leading-tight tracking-[-0.03em]">{a.title}</h3>
                    <span class="mt-1 shrink-0 text-muted transition-colors duration-300 group-hover:text-fg" aria-hidden="true">
                      <Arrow />
                    </span>
                  </span>
                  <p class="mt-3 text-small text-fg-2">{a.body}</p>
                </a>
              </li>
            ))
          }
        </ul>

        <div class="mt-10 lg:mt-12">
          <a href={c.partner.cta.href} class="btn btn-primary h-14 px-8 text-[1.0625rem]">
            {c.partner.cta.label}
            <Arrow direction="down" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-role]').forEach((link) => {
    link.addEventListener('click', () => {
      const select = document.getElementById('cf-role') as HTMLSelectElement | null;
      if (select && link.dataset.role) select.value = link.dataset.role;
    });
  });
</script>
