---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
const asA = (role: string) => `${/^[aeiou]/i.test(role) ? 'an' : 'a'} ${role.toLowerCase()}`;
---

<section id="partner" aria-labelledby="partner-heading" class="section">
  <div class="container-page">
    <SectionHeading heading={c.partner.heading} headingId="partner-heading" intro={c.partner.body} />

    <!-- Choosing an audience opens the form with the matching "I am a" option selected. -->
    <ul class="mt-16 grid gap-x-10 gap-y-10 md:grid-cols-2 lg:mt-24">
      {
        c.partner.audiences.map((a) => (
          <li>
            <a href={c.partner.cta.href} data-role={a.role} class="audience block no-underline">
              <h3 class="text-h3 text-ink">{a.title}</h3>
              <p class="mt-2 text-ink-2">{a.body}</p>
              <p class="audience-cta mt-3 text-small underline underline-offset-4">Write to us as {asA(a.role)}</p>
            </a>
          </li>
        ))
      }
    </ul>

    <a href={c.partner.cta.href} class="btn btn-gold mt-16">{c.partner.cta.label}</a>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-role]').forEach((link) => {
    link.addEventListener('click', () => {
      const select = document.getElementById('cf-role') as HTMLSelectElement | null;
      if (select && link.dataset.role) select.value = link.dataset.role;
    });
  });
</script>
