---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';
import Arrow from './Arrow.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
---

<section id="partner" aria-labelledby="partner-heading" class="section-pad">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-x-8">
      <div class="lg:col-span-7">
        <SectionHeading eyebrow={c.partner.eyebrow} heading={c.partner.heading} headingId="partner-heading" wide />
      </div>
      <p class="max-w-[38ch] text-lead text-ink lg:col-span-4 lg:col-start-9" data-reveal>{c.partner.body}</p>
    </div>

    <ul class="mt-14 border-b border-line lg:mt-20">
      {
        c.partner.audiences.map((a, i) => (
          <li class="partner-row grid gap-2 border-t border-line py-7 md:grid-cols-12 md:gap-x-8" data-reveal style={`--reveal-i:${i}`}>
            <h3 class="flex items-baseline gap-4 text-h3 font-medium md:col-span-5">
              <span class="partner-mark h-px w-5 shrink-0 translate-y-[-0.3em] bg-gold" aria-hidden="true" />
              {a.title}
            </h3>
            <p class="max-w-[52ch] pl-9 md:col-span-6 md:col-start-7 md:pl-0">{a.body}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 lg:mt-14" data-reveal>
      <a href={c.partner.cta.href} class="btn btn-primary h-14 px-7 text-[1rem]">
        {c.partner.cta.label}
        <Arrow direction="down" />
      </a>
    </div>
  </div>
</section>
