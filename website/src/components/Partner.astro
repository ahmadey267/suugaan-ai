---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';
import Arrow from './Arrow.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
---

<section id="partner" aria-labelledby="partner-heading" class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[460px] bg-[radial-gradient(45%_75%_at_50%_100%,rgb(201_162_39/0.14),transparent_70%)]" aria-hidden="true"></div>
  <div class="container-page relative">
    <div class="frame frame-top frame-pad section-pad pb-14! lg:pb-20!">
      <SectionHeading index="07" eyebrow={c.partner.eyebrow} heading={c.partner.heading} headingId="partner-heading" intro={c.partner.body} />
    </div>

    <!-- Each row jumps to the form with the matching "I am a" option selected. -->
    <ul class="frame border-t border-line">
      {
        c.partner.audiences.map((a, i) => (
          <li class="border-b border-line" data-reveal style={`--reveal-i:${i}`}>
            <a href={c.partner.cta.href} data-role={a.role} class="audience grid gap-2 py-7 md:grid-cols-12 md:items-baseline md:gap-x-8 md:px-6 lg:px-8">
              <h3 class="font-mono text-h3 font-medium md:col-span-5">{a.title}</h3>
              <p class="text-fg-2 md:col-span-6">{a.body}</p>
              <span class="audience-go hidden justify-self-end text-muted md:col-span-1 md:flex" aria-hidden="true">
                <Arrow />
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="frame frame-pad py-12 lg:py-16" data-reveal>
      <a href={c.partner.cta.href} class="btn btn-gold h-12 px-6">
        {c.partner.cta.label}
        <Arrow direction="down" />
      </a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-role]').forEach((link) => {
    link.addEventListener('click', () => {
      const select = document.getElementById('cf-role') as HTMLSelectElement | null;
      if (select && link.dataset.role) select.value = link.dataset.role;
    });
  });
</script>
