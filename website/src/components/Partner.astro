---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';
import Arrow from './Arrow.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
---

<section id="partner" aria-labelledby="partner-heading" class="relative section-pad overflow-hidden border-t border-line">
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[420px] bg-[radial-gradient(50%_70%_at_50%_100%,rgb(201_162_39/0.16),transparent_70%)]" aria-hidden="true"></div>
  <div class="container-page relative">
    <SectionHeading eyebrow={c.partner.eyebrow} heading={c.partner.heading} headingId="partner-heading" intro={c.partner.body} />

    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
      {
        c.partner.audiences.map((a, i) => (
          <li class="card flex flex-col p-5 sm:p-6" data-reveal style={`--reveal-i:${i}`}>
            <h3 class="font-mono text-h3 font-medium">{a.title}</h3>
            <p class="mt-3 text-small text-fg-2">{a.body}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-12" data-reveal>
      <a href={c.partner.cta.href} class="btn btn-gold h-12 px-6">
        {c.partner.cta.label}
        <Arrow direction="down" />
      </a>
    </div>
  </div>
</section>
