---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
---

<section id="problem" aria-labelledby="problem-heading" class="section-pad">
  <div class="container-page">
    <SectionHeading eyebrow={c.problem.eyebrow} heading={c.problem.heading} headingId="problem-heading" wide />

    <div class="mt-14 grid gap-12 lg:mt-20 lg:grid-cols-12 lg:gap-x-8">
      <p class="max-w-[34ch] text-lead text-ink lg:col-span-5" data-reveal>{c.problem.body}</p>

      <dl class="border-t-2 border-ink lg:col-span-6 lg:col-start-7">
        {
          c.problem.gaps.map((gap, i) => (
            <div class="grid gap-2 border-b border-line py-6 sm:grid-cols-[10rem_1fr] sm:gap-6" data-reveal style={`--reveal-i:${i}`}>
              <dt class="text-h3 font-medium text-ink">{gap.title}</dt>
              <dd>{gap.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
