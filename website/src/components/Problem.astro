---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
const d = c.problem.dataset;
const fmt = (n: number) => n.toLocaleString('en-GB');
const pct = (n: number) => `${((n / d.total) * 100).toFixed(1)}%`;
const slug = (s: string) => 'build-' + s.toLowerCase().replace(/[^a-z]+/g, '');
const swatch = ['#9aa2ad', '#d3d7dd', '#4189dd'];
---

<section id="problem" aria-labelledby="problem-heading" class="section pt-8! lg:pt-16!">
  <div class="container-page">
    <SectionHeading heading={c.problem.heading} headingId="problem-heading" />

    <div class="mt-14 grid gap-12 lg:mt-20 lg:grid-cols-12 lg:gap-x-10">
      <p class="text-lead text-ink lg:col-span-7">{c.problem.body}</p>

      <table class="w-full self-start lg:col-span-5">
        <caption class="pb-4 text-left text-small text-muted">{d.title}</caption>
        <tbody>
          {
            d.parts.map((p, i) => (
              <tr class="align-baseline">
                <th scope="row" class="py-2.5 pr-4 text-left font-normal text-ink-2">
                  <span class="swatch" style={`background:${swatch[i]}`} aria-hidden="true" />
                  {p.label}
                </th>
                <td class="py-2.5 pr-4 text-right text-[1.5rem] font-light tracking-[-0.02em] text-ink">{fmt(p.value)}</td>
                <td class="py-2.5 text-right text-small text-muted">{pct(p.value)}</td>
              </tr>
            ))
          }
          <tr class="align-baseline">
            <th scope="row" class="pt-4 pr-4 text-left font-medium text-ink">{d.totalLabel.charAt(0).toUpperCase() + d.totalLabel.slice(1)}</th>
            <td class="pt-4 pr-4 text-right text-[1.5rem] font-normal tracking-[-0.02em] text-ink">{fmt(d.total)}</td>
            <td class="pt-4 text-right text-small font-medium text-flag-ink">{d.highlight}</td>
          </tr>
        </tbody>
      </table>
    </div>

    <dl class="mt-20 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:mt-28 lg:grid-cols-3">
      {
        c.problem.gaps.map((gap) => (
          <div>
            <dt class="text-h3 font-medium text-ink">{gap.title}</dt>
            <dd class="mt-3 text-ink-2">{gap.body}</dd>
            <dd class="mt-4 text-small text-muted">
              {c.problem.columns[2]}:{' '}
              {gap.addressedBy.map((b, i) => (
                <>
                  {i > 0 && (i === gap.addressedBy.length - 1 ? ' and ' : ', ')}
                  <a href={`#${slug(b)}`} class="link">{b}</a>
                </>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
