---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';
import Arrow from './Arrow.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
const slug = (s: string) => 'build-' + s.toLowerCase().replace(/[^a-z]+/g, '');
---

<section id="problem" aria-labelledby="problem-heading">
  <div class="container-page">
    <div class="frame frame-top frame-pad section-pad">
      <SectionHeading index="01" eyebrow={c.problem.eyebrow} heading={c.problem.heading} headingId="problem-heading" intro={c.problem.body} />

      <div class="mt-14 lg:mt-20" data-reveal>
        <table class="w-full border-collapse text-left max-md:block">
          <thead class="max-md:hidden">
            <tr class="border-b border-line-strong">
              {c.problem.columns.map((col, i) => (
                <th scope="col" class:list={['eyebrow pb-3 font-medium text-muted', i === 1 && 'pr-6', i === 2 && 'text-right']}>{col}</th>
              ))}
            </tr>
          </thead>
          <tbody class="max-md:block">
            {
              c.problem.gaps.map((gap) => (
                <tr class="border-b border-line align-top max-md:block max-md:py-6">
                  <th scope="row" class="w-[22%] py-6 pr-6 font-mono text-h3 font-medium text-fg max-md:block max-md:w-auto max-md:p-0">{gap.title}</th>
                  <td class="py-6 pr-6 text-fg-2 max-md:block max-md:p-0 max-md:pt-2">{gap.body}</td>
                  <td class="w-[24%] py-6 text-right max-md:block max-md:w-auto max-md:p-0 max-md:pt-4 max-md:text-left">
                    <span class="inline-flex flex-wrap gap-2 md:justify-end">
                      {gap.addressedBy.map((b) => (
                        <a href={`#${slug(b)}`} class="inline-flex items-center gap-1.5 rounded-[3px] border border-line-strong px-2 py-1 font-mono text-[0.75rem] text-fg-2 transition-colors hover:border-gold hover:text-gold">
                          {b}
                          <Arrow />
                        </a>
                      ))}
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
