---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
---

<section id="problem" aria-labelledby="problem-heading" class="section-pad">
  <div class="container-page">
    <SectionHeading eyebrow={c.problem.eyebrow} heading={c.problem.heading} headingId="problem-heading" intro={c.problem.body} />

    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
      {
        c.problem.gaps.map((gap, i) => (
          <li class="card flex flex-col p-5 sm:p-6" data-reveal style={`--reveal-i:${i}`}>
            <span class="tag self-start" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-10 font-mono text-h3 font-medium">{gap.title}</h3>
            <p class="mt-3 text-small text-fg-2">{gap.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
