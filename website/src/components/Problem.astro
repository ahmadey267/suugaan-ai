---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
const slug = (s: string) => 'build-' + s.toLowerCase().replace(/[^a-z]+/g, '');
const d = c.problem.dataset;
const fmt = (n: number) => n.toLocaleString('en-GB');
const pct = (n: number) => ((n / d.total) * 100).toFixed(1);
const segStyle = [
  'bg-[linear-gradient(90deg,#2a64b0,#4189dd)]',
  'bg-[linear-gradient(90deg,#6a55d6,#9b87ef)]',
  'bg-[linear-gradient(90deg,#d9a92a,#f2d47a)]',
];
const dotStyle = ['bg-[#2a64b0]', 'bg-[#6a55d6]', 'bg-[#d9a92a]'];
---

<section id="problem" aria-labelledby="problem-heading" class="relative section-pad pt-12! md:pt-16! lg:pt-20!">
  <div class="aura-field" aria-hidden="true">
    <div class="aura aura-sky top-[30%] left-[-200px] h-[520px] w-[620px] opacity-45!"></div>
    <div class="aura aura-lilac top-[55%] right-[-200px] h-[520px] w-[620px] opacity-40!"></div>
  </div>

  <div class="container-page relative">
    <SectionHeading eyebrow={c.problem.eyebrow} heading={c.problem.heading} headingId="problem-heading" />

    <!-- The finding, as counted -->
    <figure class="glass glass-edge mt-14 p-6 sm:p-10 lg:mt-20 lg:p-12" data-reveal>
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-x-10">
        <div class="lg:col-span-5">
          <figcaption class="eyebrow text-muted">{d.title}</figcaption>
          <p class="display mt-5 text-[clamp(3.5rem,2.2rem+5vw,6.5rem)] leading-[0.9] tracking-[-0.055em] text-fg tabular-nums">
            {fmt(d.total)}
          </p>
          <p class="mt-2 text-lead text-fg-2">{d.totalLabel}</p>
          <p class="mt-8 inline-flex items-center rounded-full bg-[linear-gradient(100deg,rgb(42_100_176/0.12),rgb(106_85_214/0.12),rgb(217_169_42/0.16))] px-4 py-2 text-[1.0625rem] font-medium">
            <span class="text-gradient">{d.highlight}</span>
          </p>
        </div>

        <div class="flex flex-col justify-end lg:col-span-7">
          <!-- Proportional bar: each segment's width is its share of the total -->
          <div class="flex h-14 w-full gap-1 overflow-hidden rounded-[14px] sm:h-16" role="img" aria-label={d.parts.map((p) => `${p.label}: ${fmt(p.value)} (${pct(p.value)}%)`).join(', ')}>
            {
              d.parts.map((p, i) => (
                <span class:list={['share-seg block h-full min-w-[6px] first:rounded-l-[12px] last:rounded-r-[12px]', segStyle[i % 3]]} style={`width:${pct(p.value)}%;--i:${i}`} />
              ))
            }
          </div>
          <dl class="mt-8 grid gap-6 sm:grid-cols-3">
            {
              d.parts.map((p, i) => (
                <div class="border-t border-line pt-4">
                  <dt class="flex items-center gap-2 text-small text-fg-2">
                    <span class:list={['size-2.5 rounded-full', dotStyle[i % 3]]} aria-hidden="true" />
                    {p.label}
                  </dt>
                  <dd class="mt-2">
                    <span class="display text-[2rem] leading-none tracking-[-0.04em] text-fg tabular-nums">{fmt(p.value)}</span>
                    <span class="ml-2 font-mono text-[0.8125rem] text-muted">{pct(p.value)}%</span>
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
      <p class="mt-10 max-w-[78ch] border-t border-line pt-8 text-lead text-fg-2">{c.problem.body}</p>
    </figure>

    <!-- The gaps -->
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
      {
        c.problem.gaps.map((gap, i) => (
          <li class:list={['glass glass-hover flex flex-col p-6 lg:p-7', i < 2 ? 'lg:col-span-3' : 'lg:col-span-2']} data-reveal style={`--reveal-i:${i}`}>
            <h3 class="display text-h3">{gap.title}</h3>
            <p class="mt-3 text-small text-fg-2">{gap.body}</p>
            <p class="mt-auto flex flex-wrap gap-1.5 pt-6">
              {gap.addressedBy.map((b) => (
                <a href={`#${slug(b)}`} class="rounded-full border border-line-strong bg-white/60 px-3 py-1 font-mono text-[0.6875rem] text-fg-2 transition-colors duration-300 hover:border-sky hover:text-sky-ink">
                  {b} →
                </a>
              ))}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
