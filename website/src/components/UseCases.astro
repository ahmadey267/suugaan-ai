---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
---

<section id="use-cases" aria-labelledby="use-cases-heading">
  <div class="container-page">
    <div class="frame frame-top frame-pad section-pad pb-14! lg:pb-20!">
      <SectionHeading index="05" eyebrow={c.useCases.eyebrow} heading={c.useCases.heading} headingId="use-cases-heading" />
    </div>
    <ul class="frame grid border-t border-line sm:grid-cols-2 lg:grid-cols-4">
      {
        c.useCases.items.map((item, i) => (
          <li
            class:list={[
              'py-8 sm:px-6 lg:px-8 lg:py-10',
              i > 0 && 'border-t border-line',
              i === 1 && 'sm:border-t-0 sm:border-l',
              i === 2 && 'lg:border-t-0 lg:border-l',
              i === 3 && 'sm:border-l lg:border-t-0',
            ]}
            data-reveal
            style={`--reveal-i:${i}`}
          >
            <h3 class="font-mono text-h3 font-medium">{item.title}</h3>
            <p class="mt-3 text-small text-fg-2">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
