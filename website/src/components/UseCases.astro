---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  c: SiteContent;
  index: number;
}
const { c, index } = Astro.props;
---

<section id="use-cases" aria-labelledby="use-cases-heading" class="section-pad">
  <div class="container-page">
    <div class="grid gap-10 border-t border-line pt-6 lg:grid-cols-12 lg:gap-x-8">
      <div class="lg:col-span-4">
        <SectionHeading index={index} eyebrow={c.useCases.eyebrow} heading={c.useCases.heading} headingId="use-cases-heading" />
      </div>

      <ul class="grid gap-x-10 sm:grid-cols-2 lg:col-span-7 lg:col-start-6 lg:mt-[54px]">
        {
          c.useCases.items.map((item, i) => (
            <li class="border-t border-line pt-6 pb-10" data-reveal style={`--reveal-i:${i}`}>
              <h3 class="text-h3 font-medium">{item.title}</h3>
              <p class="mt-3">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
