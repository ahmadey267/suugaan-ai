---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
---

<section id="use-cases" aria-labelledby="use-cases-heading" class="relative section-pad">
  <div class="aura-field" aria-hidden="true">
    <div class="aura aura-gold top-[30%] left-[-120px] h-[520px] w-[640px] opacity-45!"></div>
    <div class="aura aura-lilac top-[50%] right-[-160px] h-[520px] w-[640px] opacity-40!"></div>
  </div>
  <div class="container-page relative">
    <SectionHeading eyebrow={c.useCases.eyebrow} heading={c.useCases.heading} headingId="use-cases-heading" />

    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:mt-20 lg:grid-cols-4">
      {
        c.useCases.items.map((item, i) => (
          <li class="glass glass-hover group flex min-h-[13rem] flex-col p-6" data-reveal style={`--reveal-i:${i % 4}`}>
            <span class="font-mono text-[0.75rem] text-muted tabular-nums" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="display mt-auto pt-8 text-[1.75rem] leading-[1.05] tracking-[-0.035em] transition-colors duration-500">
              <span class="hover-gradient">{item.title}</span>
            </h3>
            <p class="mt-3 text-small text-fg-2">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
