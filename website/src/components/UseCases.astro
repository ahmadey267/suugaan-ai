---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
---

<section id="use-cases" aria-labelledby="use-cases-heading" class="section-pad">
  <div class="container-page">
    <SectionHeading eyebrow={c.useCases.eyebrow} heading={c.useCases.heading} headingId="use-cases-heading" />

    <ul class="mt-14 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:mt-20 lg:grid-cols-4">
      {
        c.useCases.items.map((item, i) => (
          <li class="border-t-2 border-ink pt-5" data-reveal style={`--reveal-i:${i}`}>
            <h3 class="text-h3 font-medium">{item.title}</h3>
            <p class="mt-3">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
