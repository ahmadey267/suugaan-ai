---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
// Line icons in item order: public services, banking and telecoms, education, translation.
const icons = [
  '<path d="M3 9.5 12 4l9 5.5M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3 20.5h18"/>',
  '<rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10.5h18M7 15.5h4"/>',
  '<path d="M4 5.5h6a2 2 0 0 1 2 2V20a1.5 1.5 0 0 0-1.5-1.5H4zM20 5.5h-6a2 2 0 0 0-2 2V20a1.5 1.5 0 0 1 1.5-1.5H20z"/>',
  '<path d="M3 5h10v8H8l-3 3v-3H3zM11 15v2h5l3 3v-3h2V9h-4"/>',
];
---

<section id="use-cases" aria-labelledby="use-cases-heading" class="section-pad border-t border-line">
  <div class="container-page">
    <SectionHeading eyebrow={c.useCases.eyebrow} heading={c.useCases.heading} headingId="use-cases-heading" />

    <ul class="mt-14 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
      {
        c.useCases.items.map((item, i) => (
          <li data-reveal style={`--reveal-i:${i}`}>
            <span class="flex size-10 items-center justify-center rounded-md border border-line bg-surface">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C9A227" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" set:html={icons[i] ?? icons[0]} />
            </span>
            <h3 class="mt-6 font-mono text-h3 font-medium">{item.title}</h3>
            <p class="mt-3 text-small text-fg-2">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
