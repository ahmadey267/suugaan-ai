---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
---

<section id="use-cases" aria-labelledby="use-cases-heading" class="section">
  <div class="container-page">
    <SectionHeading heading={c.useCases.heading} headingId="use-cases-heading" />
    <ul class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:mt-24 lg:grid-cols-4">
      {
        c.useCases.items.map((item) => (
          <li>
            <h3 class="text-h3 text-ink">{item.title}</h3>
            <p class="mt-2 text-small text-ink-2">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
