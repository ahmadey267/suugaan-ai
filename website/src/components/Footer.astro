---
import type { SiteContent } from '../content/site';
import Logo from './Logo.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
---

<footer class="bg-ink text-small text-[#aeb8c4]">
  <div class="container-page flex flex-col gap-10 py-16 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-[26rem]">
      <p class="flex items-center gap-3 text-white" data-placeholder="logo">
        <Logo />
        <span class="text-[1.125rem] font-medium tracking-[-0.015em]">{c.footer.name}</span>
      </p>
      <p class="mt-5">{c.footer.line}</p>
      <p class="mt-2">{c.footer.copyright}</p>
    </div>
    <ul class="flex gap-8">
      <li>
        <a href={c.links.linkedin} class="text-white underline-offset-4 hover:underline" data-placeholder={c.links.linkedinIsPlaceholder ? 'linkedin' : undefined} rel={c.links.linkedinIsPlaceholder ? undefined : 'noopener'}>{c.footer.linkedin}</a>
      </li>
      <li>
        <a href={c.links.conceptNote} class="text-white underline-offset-4 hover:underline" data-placeholder={c.links.conceptNoteIsPlaceholder ? 'concept-note' : undefined}>{c.footer.conceptNote}</a>
      </li>
    </ul>
  </div>
</footer>
