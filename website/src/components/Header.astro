---
import type { SiteContent } from '../content/site';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
---

<header id="site-header" class="site-header sticky top-0 z-50 h-(--header-h)" data-tone="dark">
  <div class="container-page flex h-full items-center justify-between gap-4">
    <a href="#top" class="hdr-fg text-[1.125rem] font-medium tracking-[-0.01em] no-underline" data-placeholder="logo">
      {c.meta.siteName}
    </a>

    <nav aria-label={c.ui.primaryNavLabel} class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {
          c.nav.items.map((item) => (
            <li>
              <a href={item.href} class="hdr-link text-small">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <button
        type="button"
        id="menu-toggle"
        class="hdr-fg btn btn-sm px-3 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-label-open={c.ui.menuOpen}
        data-label-close={c.ui.menuClose}
      >
        {c.ui.menuOpen}
      </button>
      <a href={c.nav.cta.href} class="hdr-cta btn btn-sm">{c.nav.cta.label}</a>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label={c.ui.primaryNavLabel}
    class="absolute inset-x-0 top-full hidden border-b border-line bg-paper lg:hidden"
  >
    <ul class="container-page flex flex-col py-4">
      {
        c.nav.items.map((item) => (
          <li class="border-t border-line first:border-t-0">
            <a href={item.href} class="block py-4 text-lead text-ink">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const hero = document.getElementById('top');

  if (header && hero && 'IntersectionObserver' in window) {
    // Dark header while it sits over the dark hero, light once past it.
    const io = new IntersectionObserver(
      ([entry]) => {
        if (toggle?.getAttribute('aria-expanded') === 'true') return;
        header.dataset.tone = entry.isIntersecting ? 'dark' : 'light';
      },
      { rootMargin: `-${header.offsetHeight}px 0px 0px 0px`, threshold: 0 },
    );
    io.observe(hero);
  }

  if (toggle && menu && header) {
    let toneBeforeMenu = header.dataset.tone;
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = open ? toggle.dataset.labelClose! : toggle.dataset.labelOpen!;
      menu.classList.toggle('hidden', !open);
      if (open) {
        toneBeforeMenu = header.dataset.tone;
        header.dataset.tone = 'light';
      } else if (toneBeforeMenu) {
        header.dataset.tone = toneBeforeMenu;
      }
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) {
        toneBeforeMenu = undefined;
        setOpen(false);
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
