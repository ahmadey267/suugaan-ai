---
import type { SiteContent } from '../content/site';
import Arrow from './Arrow.astro';
import Waveform from './Waveform.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
const words = c.hero.headline.trim().split(' ');
const last = words.pop();
---

<section id="top" aria-labelledby="hero-heading" class="hero relative overflow-hidden">
  <div class="halo top-[-420px] left-1/2 h-[760px] w-[1100px] -translate-x-1/2" aria-hidden="true"></div>

  <div class="container-page relative pt-16 pb-20 md:pt-24 lg:pt-32 lg:pb-28">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-x-8">
      <h1 id="hero-heading" class="display text-display text-fg lg:col-span-8">
        <span class="line-mask"><span style="--i:0">{words.join(' ')}</span></span>
        <span class="line-mask"><span style="--i:1" class="text-gold-2">{last}</span></span>
      </h1>

      <div class="lg:col-span-4 lg:pb-3">
        <p class="hero-fade max-w-[40ch] text-lead text-fg-2" style="--i:0">{c.hero.supporting}</p>
        <div class="hero-fade mt-8 flex flex-wrap gap-3" style="--i:1">
          <a href={c.hero.primary.href} class="btn btn-gold">
            {c.hero.primary.label}
            <Arrow direction="down" />
          </a>
          <a href={c.links.conceptNote} class="btn btn-ghost" data-placeholder={c.links.conceptNoteIsPlaceholder ? 'concept-note' : undefined}>
            {c.hero.secondary.label}
            <Arrow />
          </a>
        </div>
        <p class="hero-fade mt-6 font-mono text-[0.75rem] text-muted" style="--i:2">{c.hero.small}</p>
      </div>
    </div>

    <div class="mt-16 sm:mt-20 lg:mt-24">
      <Waveform label={c.hero.alphabetLabel} caption={c.hero.alphabetCaption} summary={c.hero.alphabetSummary} />
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero) {
    const start = () => {
      requestAnimationFrame(() => hero.classList.add('is-loaded'));
      // Bars start breathing once the entrance has finished.
      setTimeout(() => hero.classList.add('wave-on'), 1700);
    };
    if (document.fonts?.ready) document.fonts.ready.then(start);
    else start();
  }
</script>
