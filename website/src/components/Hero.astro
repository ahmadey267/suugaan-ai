---
import type { SiteContent } from '../content/site';
import { currentPhase } from '../content/site';
import Arrow from './Arrow.astro';
import Alphabet from './Alphabet.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
const phase = currentPhase(c);
const phaseByNumber = new Map(c.roadmap.phases.map((p) => [p.number, p]));
const rows = c.hero.labStatus.map((row) => ({
  label: row.label,
  status: phaseByNumber.get(row.phase)?.status ?? 'planned',
}));
// Split the final word so it can carry the accent: "AI that speaks" + "Somali."
const words = c.hero.headline.trim().split(' ');
const last = words.pop();
---

<section
  id="top"
  aria-labelledby="hero-heading"
  class="on-dark relative -mt-(--header-h) bg-ink pt-[calc(var(--header-h)+3.5rem)] text-on-dark md:pt-[calc(var(--header-h)+5rem)] lg:pt-[calc(var(--header-h)+6.5rem)]"
>
  <div class="container-page">
    <h1 id="hero-heading" class="hero-title text-display font-light text-on-dark">
      {words.join(' ')} <span class="text-gold">{last}</span>
    </h1>

    <div class="mt-12 grid gap-14 md:mt-16 lg:grid-cols-12 lg:gap-x-8">
      <div class="flex flex-col lg:col-span-5">
        <p class="max-w-[36ch] text-lead text-on-dark">{c.hero.supporting}</p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a href={c.hero.primary.href} class="btn btn-gold">
            {c.hero.primary.label}
            <Arrow direction="down" />
          </a>
          <a
            href={c.links.conceptNote}
            class="btn btn-ghost-dark"
            data-placeholder={c.links.conceptNoteIsPlaceholder ? 'concept-note' : undefined}
          >
            {c.hero.secondary.label}
            <Arrow />
          </a>
        </div>

        <p class="mt-8 text-small text-on-dark-muted lg:mt-auto lg:pt-10">{c.hero.small}</p>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <Alphabet label={c.hero.alphabetLabel} caption={c.hero.alphabetCaption} />
      </div>
    </div>

    <div
      class="mt-16 grid grid-cols-2 border-t border-line-dark md:mt-20 md:grid-cols-5"
      role="group"
      aria-labelledby="lab-status-heading"
    >
      <p id="lab-status-heading" class="eyebrow col-span-2 py-5 text-on-dark-muted md:col-span-1">
        {c.ui.labStatus}
      </p>
      {
        rows.map((row) => (
          <p class="flex flex-col gap-1 border-t border-line-dark py-5 md:border-t-0 md:border-l md:pl-5">
            <span class="text-small text-on-dark">{row.label}</span>
            <span
              class:list={[
                'eyebrow inline-flex items-center gap-2',
                row.status === 'in-progress' ? 'text-gold' : 'text-on-dark-muted',
              ]}
            >
              {row.status === 'in-progress' && <span class="size-1.5 rounded-full bg-gold" aria-hidden="true" />}
              {c.ui.statusLabels[row.status]}
            </span>
          </p>
        ))
      }
    </div>
    <p class="sr-only">
      {c.ui.phaseWord} {phase.number}. {phase.name}: {c.ui.statusLabels[phase.status]}
    </p>
  </div>
</section>
