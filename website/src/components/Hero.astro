---
import type { SiteContent } from '../content/site';
import { currentPhase } from '../content/site';
import Arrow from './Arrow.astro';
import Waveform from './Waveform.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
const phase = currentPhase(c);
// Split the headline around the accent so the accent can carry the gradient.
const h = c.hero.headline;
const at = h.indexOf(c.hero.headlineAccent);
const before = at >= 0 ? h.slice(0, at) : h;
const accent = at >= 0 ? c.hero.headlineAccent : '';
const after = at >= 0 ? h.slice(at + accent.length) : '';
---

<section id="top" aria-labelledby="hero-heading" class="hero relative">
  <!-- Light behind the glass -->
  <div class="aura-field" aria-hidden="true">
    <div class="aura aura-sky aura-drift top-[-220px] left-[-160px] h-[620px] w-[720px]"></div>
    <div class="aura aura-lilac aura-drift-2 top-[-120px] right-[-180px] h-[560px] w-[680px]"></div>
    <div class="aura aura-gold aura-drift top-[520px] left-[28%] h-[520px] w-[760px] opacity-60!"></div>
    <div class="aura aura-peach aura-drift-2 top-[760px] right-[-120px] h-[420px] w-[520px]"></div>
  </div>

  <div class="container-page relative pt-[calc(var(--header-h)+3.5rem)] pb-16 text-center md:pt-[calc(var(--header-h)+5rem)] lg:pt-[calc(var(--header-h)+6.5rem)] lg:pb-24">
    <a href="#roadmap" class="hero-fade chip mx-auto no-underline hover:text-fg" style="--i:0">
      <span class="flex items-center gap-1.5 text-sky-ink">
        <span class="size-1.5 animate-pulse rounded-full bg-sky" aria-hidden="true"></span>
        {c.ui.statusLabels[phase.status]}
      </span>
      <span>{c.ui.phaseWord} {phase.number}. {phase.name}</span>
      <Arrow />
    </a>

    <h1 id="hero-heading" class="display mx-auto mt-8 max-w-[14ch] text-display text-fg">
      <span class="line-mask"><span style="--i:0">{before}<span class="text-gradient">{accent}</span>{after}</span></span>
    </h1>

    <p class="hero-fade mx-auto mt-8 max-w-[58ch] text-lead text-fg-2" style="--i:1">{c.hero.supporting}</p>

    <div class="hero-fade mt-10 flex flex-wrap justify-center gap-3" style="--i:2">
      <a href={c.hero.primary.href} class="btn btn-primary">
        {c.hero.primary.label}
        <Arrow direction="down" />
      </a>
      <a href={c.links.conceptNote} class="btn btn-glass" data-placeholder={c.links.conceptNoteIsPlaceholder ? 'concept-note' : undefined}>
        {c.hero.secondary.label}
        <Arrow />
      </a>
    </div>
    <p class="hero-fade mt-6 text-small text-muted" style="--i:3">{c.hero.small}</p>

    <!-- Signature: the alphabet as a waveform, on a glass panel -->
    <div class="hero-fade relative mx-auto mt-16 max-w-[1180px] text-left sm:mt-20 lg:mt-24" style="--i:4">
      <div class="glass">
        <Waveform label={c.hero.alphabetLabel} caption={c.hero.alphabetCaption} summary={c.hero.alphabetSummary} />
      </div>
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero) {
    const start = () => {
      requestAnimationFrame(() => hero.classList.add('is-loaded'));
      setTimeout(() => hero.classList.add('wave-on'), 1900);
    };
    if (document.fonts?.ready) document.fonts.ready.then(start);
    else start();
  }
</script>
