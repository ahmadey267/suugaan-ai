---
import type { SiteContent } from '../content/site';
import DataField from './DataField.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
---

<section id="top" aria-labelledby="hero-heading" class="relative">
  <div class="top-light" aria-hidden="true"></div>
  <div class="container-page relative grid gap-14 pt-[calc(var(--header-h)+3rem)] pb-16 lg:grid-cols-12 lg:items-center lg:gap-x-10 lg:pt-[calc(var(--header-h)+5.5rem)] lg:pb-24">
    <div class="lg:col-span-6">
      <h1 id="hero-heading" class="text-display text-ink">{c.hero.headline}</h1>
      <p class="mt-8 max-w-[34rem] text-lead text-ink-2">{c.hero.supporting}</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href={c.hero.primary.href} class="btn btn-gold">{c.hero.primary.label}</a>
        <a href={c.links.conceptNote} class="btn btn-line" data-placeholder={c.links.conceptNoteIsPlaceholder ? 'concept-note' : undefined}>
          {c.hero.secondary.label}
        </a>
      </div>
      <p class="mt-8 text-small text-muted">{c.hero.small}</p>
    </div>
    <div class="lg:col-span-6">
      <DataField c={c} />
    </div>
  </div>
</section>
