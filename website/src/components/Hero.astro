---
import type { SiteContent } from '../content/site';
import { currentPhase } from '../content/site';
import Arrow from './Arrow.astro';
import StatusPill from './StatusPill.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
const phase = currentPhase(c);
const phaseByNumber = new Map(c.roadmap.phases.map((p) => [p.number, p]));
const rows = c.hero.labStatus.map((row) => ({
  label: row.label,
  status: phaseByNumber.get(row.phase)?.status ?? 'planned',
}));
---

<section id="top" aria-labelledby="hero-heading" class="pt-16 pb-16 md:pt-24 md:pb-24 lg:pt-36 lg:pb-32">
  <div class="container-page">
    <h1
      id="hero-heading"
      class="max-w-[11ch] text-display font-light text-ink lg:max-w-none"
    >
      {c.hero.headline}
    </h1>

    <div class="mt-10 grid gap-12 md:mt-14 lg:mt-20 lg:grid-cols-12 lg:gap-x-8">
      <div class="lg:col-span-7">
        <p class="max-w-[38ch] text-lead text-ink-2">{c.hero.supporting}</p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a href={c.hero.primary.href} class="btn btn-primary">
            {c.hero.primary.label}
            <Arrow direction="down" />
          </a>
          <a
            href={c.links.conceptNote}
            class="btn btn-secondary"
            data-placeholder={c.links.conceptNoteIsPlaceholder ? 'concept-note' : undefined}
          >
            {c.hero.secondary.label}
            <Arrow />
          </a>
        </div>

        <p class="mt-8 text-small text-muted">{c.hero.small}</p>
      </div>

      <aside
        aria-labelledby="lab-status-heading"
        class="self-end border border-line p-6 lg:col-span-4 lg:col-start-9"
      >
        <p id="lab-status-heading" class="eyebrow text-muted">{c.ui.labStatus}</p>
        <dl class="mt-4">
          {
            rows.map((row) => (
              <div class="flex items-center justify-between gap-4 border-t border-line py-3">
                <dt class="text-small text-ink">{row.label}</dt>
                <dd>
                  <StatusPill status={row.status} label={c.ui.statusLabels[row.status]} />
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="flex items-center justify-between gap-4 border-t border-ink pt-4 text-small text-ink">
          <a href="#roadmap" class="link">
            {c.ui.phaseWord} {phase.number}. {phase.name}
          </a>
          <StatusPill status={phase.status} label={c.ui.statusLabels[phase.status]} />
        </p>
      </aside>
    </div>
  </div>
</section>
