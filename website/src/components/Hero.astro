---
import type { SiteContent } from '../content/site';
import { currentPhase } from '../content/site';
import Arrow from './Arrow.astro';
import Alphabet from './Alphabet.astro';
import StatusPill from './StatusPill.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
const phase = currentPhase(c);
const phases = c.roadmap.phases;
const phaseByNumber = new Map(phases.map((p) => [p.number, p]));
const rows = c.hero.labStatus.map((row) => {
  const p = phaseByNumber.get(row.phase);
  return { label: row.label, phase: row.phase, status: p?.status ?? 'planned' };
});
const words = c.hero.headline.trim().split(' ');
const last = words.pop();
---

<section id="top" aria-labelledby="hero-heading" class="relative overflow-hidden">
  <div class="aurora" aria-hidden="true"></div>

  <div class="container-page relative">
    <div class="frame frame-pad pt-20 pb-16 md:pt-28 lg:pt-36 lg:pb-24">
      <h1 id="hero-heading" class="mono-heading max-w-[14ch] text-display text-fg">
        {words.join(' ')} <span class="text-gold">{last}</span>
      </h1>

      <div class="mt-10 grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-x-8">
        <p class="max-w-[46ch] text-lead text-fg-2 lg:col-span-6">{c.hero.supporting}</p>
        <div class="flex flex-wrap gap-3 lg:col-span-6 lg:justify-end">
          <a href={c.hero.primary.href} class="btn btn-gold">
            {c.hero.primary.label}
            <Arrow direction="down" />
          </a>
          <a href={c.links.conceptNote} class="btn btn-ghost" data-placeholder={c.links.conceptNoteIsPlaceholder ? 'concept-note' : undefined}>
            {c.hero.secondary.label}
            <Arrow />
          </a>
        </div>
      </div>
    </div>

    <!-- Lab panel. Statuses come from the roadmap in site.ts; the alphabet is the standard orthography. -->
    <div class="frame frame-top grid border-b border-line bg-bg/60 lg:grid-cols-12" role="group" aria-labelledby="lab-status-heading">
      <div class="flex flex-col border-b border-line lg:col-span-5 lg:border-r lg:border-b-0">
        <div class="flex items-center justify-between gap-4 border-b border-line py-4 md:px-6">
          <p id="lab-status-heading" class="eyebrow text-muted">{c.ui.labStatus}</p>
          <StatusPill status={phase.status} label={`${c.ui.phaseWord} ${phase.number}`} />
        </div>
        <table class="w-full font-mono text-code">
          <thead class="sr-only">
            <tr><th>{c.build.eyebrow}</th><th>{c.ui.phaseWord}</th><th>{c.ui.labStatus}</th></tr>
          </thead>
          <tbody>
            {
              rows.map((r) => (
                <tr class="border-b border-line last:border-b-0">
                  <th scope="row" class="py-4 text-left font-normal text-fg md:pl-6">{r.label}</th>
                  <td class="py-4 text-muted tabular-nums">{c.ui.phaseWord.toLowerCase()} {r.phase}</td>
                  <td class="py-4 text-right md:pr-6">
                    <span class:list={['inline-flex items-center gap-2', r.status === 'in-progress' ? 'text-gold' : 'text-muted']}>
                      {r.status === 'in-progress' && <span class="size-1.5 rounded-full bg-gold" aria-hidden="true" />}
                      {c.ui.statusLabels[r.status].toLowerCase()}
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <div class="mt-auto flex items-center gap-4 border-t border-line py-4 md:px-6" aria-hidden="true">
          <span class="font-mono text-[0.75rem] text-muted tabular-nums">{phase.number}/{phases.length}</span>
          <span class="grid flex-1 grid-cols-4 gap-1">
            {phases.map((p) => <span class:list={['h-1.5', p.number === phase.number ? 'hatch' : p.status === 'done' ? 'bg-gold' : 'bg-line']} />)}
          </span>
          <span class="font-mono text-[0.75rem] text-fg-2">{phase.name.toLowerCase()}</span>
        </div>
      </div>
      <div class="py-6 md:px-6 lg:col-span-7">
        <Alphabet label={c.hero.alphabetLabel} caption={c.hero.alphabetCaption} />
      </div>
    </div>

    <div class="frame frame-pad py-6">
      <p class="font-mono text-[0.8125rem] text-muted">{c.hero.small}</p>
    </div>
  </div>
</section>
