---
import type { SiteContent } from '../content/site';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Problem from './Problem.astro';
import Build from './Build.astro';
import Approach from './Approach.astro';
import Roadmap from './Roadmap.astro';
import UseCases from './UseCases.astro';
import Team from './Team.astro';
import Partner from './Partner.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
---

<Base c={c}>
  <Header c={c} />
  <main id="main" tabindex="-1" class="outline-none">
    <Hero c={c} />
    <Problem c={c} index={1} />
    <Build c={c} index={2} />
    <Approach c={c} index={3} />
    <Roadmap c={c} index={4} />
    <UseCases c={c} index={5} />
    <Team c={c} index={6} />
    <Partner c={c} index={7} />
    <Contact c={c} index={8} />
  </main>
  <Footer c={c} />
</Base>
