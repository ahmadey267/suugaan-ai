---
import type { PhaseStatus } from '../content/site';

interface Props {
  status: PhaseStatus;
  label: string;
}
const { status, label } = Astro.props;
const styles: Record<PhaseStatus, string> = {
  'in-progress': 'text-sky-ink',
  next: 'text-fg-2',
  planned: 'text-muted',
  done: 'text-success',
};
const dots: Record<PhaseStatus, string> = {
  'in-progress': 'bg-sky animate-pulse',
  next: 'bg-fg-2',
  planned: 'bg-[rgb(14_17_23/0.25)]',
  done: 'bg-success',
};
---

<span class:list={['inline-flex shrink-0 items-center gap-1.5 font-mono text-[0.6875rem] tracking-[0.04em] whitespace-nowrap uppercase', styles[status]]}>
  <span class:list={['size-1.5 rounded-full', dots[status]]} aria-hidden="true" />
  {label}
</span>
