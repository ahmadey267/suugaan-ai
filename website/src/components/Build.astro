---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';
import DemoSlot from './DemoSlot.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
const phaseByNumber = new Map(c.roadmap.phases.map((p) => [p.number, p]));
const statusOf = (title: string) => {
  const row = c.hero.labStatus.find((r) => r.label.toLowerCase() === title.toLowerCase().replace(/\.$/, ''));
  const phase = row ? phaseByNumber.get(row.phase) : undefined;
  return phase ? { phase: phase.number, label: c.ui.statusLabels[phase.status], live: phase.status === 'in-progress' } : null;
};
const slug = (s: string) => 'build-' + s.toLowerCase().replace(/[^a-z]+/g, '');
const list = (xs: string[]) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`);
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<section id="build" aria-labelledby="build-heading" class="section bg-white">
  <div class="container-page">
    <SectionHeading heading={c.build.heading} headingId="build-heading" />

    <div class="mt-16 grid gap-x-16 gap-y-16 md:grid-cols-2 lg:mt-24">
      {
        c.build.blocks.map((b) => {
          const st = statusOf(b.title);
          return (
            <article id={slug(b.title)} class="max-w-[34rem]">
              <h3 class="text-[1.75rem] leading-tight font-light tracking-[-0.02em] text-ink">{b.title}</h3>
              {st && (
                <p class="mt-2 flex items-center gap-2 text-small text-muted">
                  <span class:list={['size-2 rounded-full', st.live ? 'bg-flag' : 'bg-scripture']} aria-hidden="true" />
                  {c.ui.phaseWord} {st.phase}, {st.label.toLowerCase()}
                </p>
              )}
              <p class="mt-5 text-ink-2">{b.body}</p>
              {b.detail.length > 0 && <p class="mt-4 text-small text-ink">{cap(list(b.detail))}.</p>}
            </article>
          );
        })
      }
    </div>

    <p class="mt-24 max-w-[44rem] text-h2 text-ink lg:mt-32">{c.build.closing}</p>
    {c.demo.enabled && <DemoSlot c={c} />}
  </div>
</section>
