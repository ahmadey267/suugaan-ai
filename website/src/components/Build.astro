---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';
import StatusPill from './StatusPill.astro';
import DemoSlot from './DemoSlot.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
const [data, models, bench, voice] = c.build.blocks;
const phaseByNumber = new Map(c.roadmap.phases.map((p) => [p.number, p]));
const statusFor = (title: string) => {
  const row = c.hero.labStatus.find((r) => r.label.toLowerCase() === title.toLowerCase().replace(/\.$/, ''));
  return (row && phaseByNumber.get(row.phase)?.status) || 'planned';
};
const slug = (s: string) => 'build-' + s.toLowerCase().replace(/[^a-z]+/g, '');
const voiceStatus = statusFor(voice.title);
const bars = [6, 14, 22, 12, 30, 18, 38, 26, 16, 34, 20, 10, 28, 40, 24, 14, 32, 18, 8, 22, 30, 12, 20, 6, 16, 26, 10, 34, 18, 8];
const [first, ...rest] = c.build.closing.split(/(?<=\.)\s+/);
const pipeline = [data, models, bench];
---

<section id="build" aria-labelledby="build-heading">
  <div class="container-page">
    <div class="frame frame-top frame-pad section-pad pb-14! lg:pb-20!">
      <SectionHeading index="02" eyebrow={c.build.eyebrow} heading={c.build.heading} headingId="build-heading" />
    </div>

    <!-- Pipeline: data feeds models, the benchmark scores them. -->
    <ol class="frame grid border-t border-line lg:grid-cols-3">
      {
        pipeline.map((block, i) => (
          <li
            id={slug(block.title)}
            class:list={['relative flex flex-col py-8 md:px-6 lg:px-8 lg:py-10', i > 0 && 'border-t border-line lg:border-t-0 lg:border-l']}
            data-reveal
            style={`--reveal-i:${i}`}
          >
            {i > 0 && (
              <span aria-hidden="true" class="absolute -top-3.5 left-1/2 z-10 flex size-7 -translate-x-1/2 rotate-90 items-center justify-center rounded-full border border-line-strong bg-bg text-gold lg:top-12 lg:-left-3.5 lg:translate-x-0 lg:rotate-0">
                <svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M1 7h11M7.5 2.5 12 7l-4.5 4.5" stroke="currentColor" stroke-width="1.5" /></svg>
              </span>
            )}
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-mono text-[1.375rem] font-medium tracking-[-0.03em]">{block.title}</h3>
              <StatusPill status={statusFor(block.title)} label={c.ui.statusLabels[statusFor(block.title)]} />
            </div>
            <p class="mt-4 text-fg-2">{block.body}</p>

            <div class="mt-8 lg:mt-auto lg:pt-10" aria-hidden="true">
              {i === 0 && (
                <div class="font-mono text-code text-fg-2">
                  <p class="text-fg">corpus/</p>
                  {block.detail.map((d, j) => (
                    <p><span class="text-muted">{j === block.detail.length - 1 ? '└── ' : '├── '}</span>{d}/</p>
                  ))}
                  <p class="mt-3 flex flex-wrap gap-1.5">
                    {c.build.dataTags.map((t) => <span class="rounded-[3px] bg-gold-soft px-1.5 py-0.5 text-gold">{t}</span>)}
                  </p>
                </div>
              )}
              {i === 1 && (
                <ul class="font-mono text-code">
                  {block.detail.map((d) => (
                    <li class="flex items-center gap-3 border-t border-line py-2.5 text-fg-2 first:border-t-0">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6.5 4.8 9 10 3" stroke="#C9A227" stroke-width="1.6" /></svg>
                      {d}
                    </li>
                  ))}
                </ul>
              )}
              {i === 2 && (
                <table class="w-full font-mono text-code">
                  <thead>
                    <tr class="text-left text-muted">
                      {c.ui.benchColumns.map((col, k) => <th class:list={['pb-2 font-normal', k > 0 && 'text-right']}>{col}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {block.detail.map((d) => (
                      <tr class="border-t border-line">
                        <td class="py-2.5 text-fg-2">{d}</td>
                        <td class="py-2.5 text-right text-muted">{c.ui.pending}</td>
                        <td class="py-2.5 text-right text-muted">{c.ui.pending}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <!-- Voice runs as its own track. -->
    <div id={slug(voice.title)} class="frame grid gap-6 border-t border-line py-8 md:px-6 lg:grid-cols-12 lg:items-center lg:gap-x-8 lg:px-8 lg:py-10" data-reveal>
      <div class="lg:col-span-5">
        <div class="flex items-center gap-4">
          <h3 class="font-mono text-[1.375rem] font-medium tracking-[-0.03em]">{voice.title}</h3>
          <StatusPill status={voiceStatus} label={c.ui.statusLabels[voiceStatus]} />
        </div>
        <p class="mt-4 text-fg-2">{voice.body}</p>
      </div>
      <div class="flex h-16 items-center gap-[3px] overflow-hidden lg:col-span-6 lg:col-start-7 lg:justify-end" aria-hidden="true">
        {bars.map((h) => <span class="w-[3px] shrink-0 rounded-full bg-gold/45" style={`height:${h}px`} />)}
      </div>
    </div>

    <!-- Output of the pipeline. -->
    <div class="frame frame-pad border-t border-line py-10 lg:py-14" data-reveal>
      <p class="mono-heading flex max-w-[34ch] gap-4 text-[clamp(1.25rem,1rem+1.1vw,1.875rem)] leading-snug tracking-[-0.03em] text-fg">
        <span class="text-gold" aria-hidden="true">→</span>
        <span>{first} <span class="text-dim">{rest.join(' ')}</span></span>
      </p>
      {c.demo.enabled && <DemoSlot c={c} />}
    </div>
  </div>
</section>
