---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';
import StatusPill from './StatusPill.astro';
import DemoSlot from './DemoSlot.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
const [data, models, bench, voice] = c.build.blocks;
const phaseByNumber = new Map(c.roadmap.phases.map((p) => [p.number, p]));
const statusFor = (label: string) => {
  const row = c.hero.labStatus.find((r) => r.label.toLowerCase() === label.toLowerCase().replace(/\.$/, ''));
  return (row && phaseByNumber.get(row.phase)?.status) || 'planned';
};
const voiceStatus = statusFor(voice.title);
// Fixed bar heights for the voice waveform illustration.
const bars = [6, 14, 22, 12, 30, 18, 38, 26, 16, 34, 20, 10, 28, 40, 24, 14, 32, 18, 8, 22, 30, 12, 20, 6];
const [first, ...rest] = c.build.closing.split(/(?<=\.)\s+/);
---

<section id="build" aria-labelledby="build-heading" class="section-pad">
  <div class="container-page">
    <SectionHeading eyebrow={c.build.eyebrow} heading={c.build.heading} headingId="build-heading" />

    <ul class="mt-14 grid gap-4 md:grid-cols-2 lg:mt-16">
      <li class="card flex min-w-0 flex-col p-5 sm:p-6" data-reveal>
        <div class="rounded-md border border-line bg-bg p-4 font-mono text-code text-fg-2" aria-hidden="true">
          <p class="text-fg">corpus/</p>
          {data.detail.map((d, i) => (
            <p><span class="text-dim">{i === data.detail.length - 1 ? '└── ' : '├── '}</span>{d}/</p>
          ))}
          <p class="mt-2 text-muted">tags: {c.build.dataTags.map((t) => <span class="mr-2 text-gold">{t}</span>)}</p>
        </div>
        <h3 class="mt-6 font-mono text-h3 font-medium">{data.title}</h3>
        <p class="mt-3 text-fg-2">{data.body}</p>
      </li>

      <li class="card flex min-w-0 flex-col p-5 sm:p-6" data-reveal style="--reveal-i:1">
        <ul class="grid gap-2 font-mono text-code sm:grid-cols-2" aria-hidden="true">
          {models.detail.map((d) => (
            <li class="flex items-center gap-2 rounded-md border border-line bg-bg px-3 py-3 text-fg-2">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6.5 4.8 9 10 3" stroke="#C9A227" stroke-width="1.6" /></svg>
              {d}
            </li>
          ))}
        </ul>
        <h3 class="mt-6 font-mono text-h3 font-medium">{models.title}</h3>
        <p class="mt-3 text-fg-2">{models.body}</p>
      </li>

      <li class="card flex min-w-0 flex-col p-5 sm:p-6" data-reveal style="--reveal-i:2">
        <div class="overflow-x-auto rounded-md border border-line bg-bg" aria-hidden="true">
          <table class="w-full font-mono text-code">
            <thead>
              <tr class="text-left text-dim">
                {c.ui.benchColumns.map((col) => <th class="px-4 py-2.5 font-normal">{col}</th>)}
              </tr>
            </thead>
            <tbody>
              {bench.detail.map((d) => (
                <tr class="border-t border-line">
                  <td class="px-4 py-2.5 whitespace-nowrap text-fg-2">{d}</td>
                  <td class="px-4 py-2.5 text-muted">{c.ui.pending}</td>
                  <td class="px-4 py-2.5 text-muted">{c.ui.pending}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <h3 class="mt-6 font-mono text-h3 font-medium">{bench.title}</h3>
        <p class="mt-3 text-fg-2">{bench.body}</p>
      </li>

      <li class="card flex min-w-0 flex-col p-5 sm:p-6" data-reveal style="--reveal-i:3">
        <div class="flex h-[134px] items-center justify-between gap-4 rounded-md border border-line bg-bg px-4" aria-hidden="true">
          <span class="flex h-12 items-center gap-[3px]">
            {bars.map((h) => <span class="w-[3px] rounded-full bg-gold/70" style={`height:${h}px`} />)}
          </span>
          <StatusPill status={voiceStatus} label={c.ui.statusLabels[voiceStatus]} />
        </div>
        <h3 class="mt-6 font-mono text-h3 font-medium">{voice.title}</h3>
        <p class="mt-3 text-fg-2">{voice.body}</p>
      </li>
    </ul>

    <p class="mono-heading mt-16 max-w-[30ch] text-[clamp(1.375rem,1.1rem+1.2vw,2rem)] leading-snug tracking-[-0.03em] text-fg lg:mt-20" data-reveal>
      {first} <span class="text-dim">{rest.join(' ')}</span>
    </p>

    {c.demo.enabled && <DemoSlot c={c} />}
  </div>
</section>
