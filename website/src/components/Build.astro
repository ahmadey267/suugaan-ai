---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';
import DemoSlot from './DemoSlot.astro';

interface Props {
  c: SiteContent;
  index: number;
}
const { c, index } = Astro.props;
---

<section id="build" aria-labelledby="build-heading" class="section-pad">
  <div class="container-page">
    <div class="border-t border-line pt-6">
      <SectionHeading index={index} eyebrow={c.build.eyebrow} heading={c.build.heading} headingId="build-heading" />
    </div>

    <ul class="mt-14 grid border-b border-line md:grid-cols-2 lg:mt-20">
      {
        c.build.blocks.map((block, i) => (
          <li
            class:list={[
              'border-t border-line pt-6 pb-10 md:pb-14',
              i % 2 === 0 ? 'md:pr-10 lg:pr-16' : 'md:border-l md:pl-10 lg:pl-16',
            ]}
            data-reveal
            style={`--reveal-i:${i}`}
          >
            <p class="eyebrow text-muted" aria-hidden="true">{String.fromCharCode(65 + i)}</p>
            <h3 class="mt-6 text-h3 font-medium">{block.title}</h3>
            <p class="mt-3 max-w-[48ch]">{block.body}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-14 grid lg:mt-20 lg:grid-cols-12 lg:gap-x-8" data-reveal>
      <p class="text-lead text-ink lg:col-span-7 lg:col-start-6">
        <span class="mb-5 block h-px w-6 bg-gold" aria-hidden="true"></span>
        {c.build.closing}
      </p>
    </div>

    {c.demo.enabled && <DemoSlot c={c} />}
  </div>
</section>
