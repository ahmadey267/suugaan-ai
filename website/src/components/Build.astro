---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';
import StatusPill from './StatusPill.astro';
import DemoSlot from './DemoSlot.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
const [data, models, bench, voice] = c.build.blocks;
const phaseByNumber = new Map(c.roadmap.phases.map((p) => [p.number, p]));
const statusFor = (title: string) => {
  const row = c.hero.labStatus.find((r) => r.label.toLowerCase() === title.toLowerCase().replace(/\.$/, ''));
  return (row && phaseByNumber.get(row.phase)?.status) || 'planned';
};
const slug = (s: string) => 'build-' + s.toLowerCase().replace(/[^a-z]+/g, '');
const amp = (i: number) => 0.12 + 0.88 * Math.abs(Math.sin(i * 0.47) * Math.cos(i * 0.17 + 0.4));
const voiceBars = Array.from({ length: 64 }, (_, i) => amp(i));
const [first, ...rest] = c.build.closing.split(/(?<=\.)\s+/);
---

<section id="build" aria-labelledby="build-heading" class="section-pad">
  <div class="container-page">
    <SectionHeading eyebrow={c.build.eyebrow} heading={c.build.heading} headingId="build-heading" />

    <ul class="mt-16 grid gap-4 lg:mt-24 lg:grid-cols-12">
      <!-- Data: tall card with the corpus structure -->
      <li id={slug(data.title)} class="card card-hover flex min-w-0 flex-col p-6 lg:col-span-5 lg:row-span-2 lg:p-8" data-reveal>
        <div class="flex items-center justify-between gap-3">
          <h3 class="display text-h3">{data.title}</h3>
          <StatusPill status={statusFor(data.title)} label={c.ui.statusLabels[statusFor(data.title)]} />
        </div>
        <p class="mt-4 text-fg-2">{data.body}</p>
        <div class="well mt-8 p-5 font-mono text-code text-fg-2 lg:mt-auto" aria-hidden="true">
          <p class="text-fg">corpus/</p>
          {data.detail.map((d, j) => (
            <p class="flex items-center gap-3">
              <span class="text-muted">{j === data.detail.length - 1 ? '└──' : '├──'}</span>
              {d}/
            </p>
          ))}
          <p class="mt-4 flex flex-wrap gap-1.5">
            {c.build.dataTags.map((t) => <span class="rounded-full bg-gold-soft px-2.5 py-0.5 text-gold-2">{t}</span>)}
          </p>
        </div>
      </li>

      <!-- Models -->
      <li id={slug(models.title)} class="card card-hover grid min-w-0 gap-6 p-6 sm:grid-cols-2 lg:col-span-7 lg:p-8" data-reveal style="--reveal-i:1">
        <div>
          <div class="flex items-center gap-3">
            <h3 class="display text-h3">{models.title}</h3>
            <StatusPill status={statusFor(models.title)} label={c.ui.statusLabels[statusFor(models.title)]} />
          </div>
          <p class="mt-4 text-fg-2">{models.body}</p>
        </div>
        <ul class="well grid content-start gap-px overflow-hidden p-1 font-mono text-code" aria-hidden="true">
          {models.detail.map((d) => (
            <li class="flex items-center gap-3 rounded-md px-3 py-2.5 text-fg-2">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="6.25" stroke="rgb(201 162 39 / 0.5)" /><path d="M4.2 7.3 6.1 9.1 9.9 5" stroke="#E7C55A" stroke-width="1.4" /></svg>
              {d}
            </li>
          ))}
        </ul>
      </li>

      <!-- Benchmark -->
      <li id={slug(bench.title)} class="card card-hover grid min-w-0 gap-6 p-6 sm:grid-cols-[1fr_1.15fr] lg:col-span-7 lg:p-8" data-reveal style="--reveal-i:2">
        <div>
          <div class="flex items-center gap-3">
            <h3 class="display text-h3">{bench.title}</h3>
            <StatusPill status={statusFor(bench.title)} label={c.ui.statusLabels[statusFor(bench.title)]} />
          </div>
          <p class="mt-4 text-fg-2">{bench.body}</p>
        </div>
        <div class="well overflow-x-auto p-4" aria-hidden="true">
          <table class="w-full font-mono text-code">
            <thead>
              <tr class="text-left text-muted">
                {c.ui.benchColumns.map((col, k) => <th class:list={['pb-3 align-bottom leading-tight font-normal', k > 0 && 'w-[4.25rem] pl-2 text-right sm:w-[5.5rem] sm:pl-3']}>{col}</th>)}
              </tr>
            </thead>
            <tbody>
              {bench.detail.map((d) => (
                <tr class="border-t border-line">
                  <td class="py-2.5 pr-3 whitespace-nowrap text-fg-2">{d}</td>
                  <td class="py-2.5 text-right"><span class="inline-block h-1.5 w-10 rounded-full bg-line-strong" /></td>
                  <td class="py-2.5 text-right"><span class="inline-block h-1.5 w-10 rounded-full bg-line-strong" /></td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-3 font-mono text-[0.6875rem] text-muted">{c.ui.pending}</p>
        </div>
      </li>

      <!-- Voice: full width -->
      <li id={slug(voice.title)} class="card card-hover grid min-w-0 gap-6 overflow-hidden p-6 lg:col-span-12 lg:grid-cols-12 lg:items-center lg:p-8" data-reveal style="--reveal-i:3">
        <div class="lg:col-span-4">
          <div class="flex items-center gap-3">
            <h3 class="display text-h3">{voice.title}</h3>
            <StatusPill status={statusFor(voice.title)} label={c.ui.statusLabels[statusFor(voice.title)]} />
          </div>
          <p class="mt-4 text-fg-2">{voice.body}</p>
        </div>
        <div class="flex h-24 items-center justify-between gap-[3px] lg:col-span-8 lg:h-28" aria-hidden="true">
          {voiceBars.map((a) => (
            <span class="w-[3px] shrink-0 rounded-full bg-[rgb(243_241_234/0.18)]" style={`height:${Math.round(a * 100)}%`} />
          ))}
        </div>
      </li>
    </ul>

    <p class="display mt-20 flex max-w-[30ch] gap-5 text-[clamp(1.75rem,1.2rem+2.2vw,3rem)] leading-[1.08] tracking-[-0.04em] text-fg lg:mt-28" data-reveal>
      <span class="text-gold-2" aria-hidden="true">→</span>
      <span>{first} <span class="text-dim">{rest.join(' ')}</span></span>
    </p>

    {c.demo.enabled && <DemoSlot c={c} />}
  </div>
</section>
