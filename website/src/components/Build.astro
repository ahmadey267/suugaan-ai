---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';
import DemoSlot from './DemoSlot.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
---

<section id="build" aria-labelledby="build-heading" class="section-pad bg-paper-2">
  <div class="container-page">
    <SectionHeading eyebrow={c.build.eyebrow} heading={c.build.heading} headingId="build-heading" wide />

    <ul class="mt-14 border-b border-ink lg:mt-20">
      {
        c.build.blocks.map((block, i) => (
          <li class="build-row grid items-baseline gap-3 border-t border-ink py-8 md:grid-cols-12 md:gap-x-8 md:py-10" data-reveal style={`--reveal-i:${i}`}>
            <h3 class="text-[clamp(2.5rem,1.4rem+4.6vw,5.5rem)] leading-none font-light tracking-[-0.035em] text-ink md:col-span-6">
              {block.title.replace(/\.$/, '')}
              <span class="text-gold">.</span>
            </h3>
            <p class="max-w-[44ch] md:col-span-5 md:col-start-8">{block.body}</p>
          </li>
        ))
      }
    </ul>

    <p class="mt-16 max-w-[24ch] text-h2 font-light text-ink lg:mt-24" data-reveal>
      {c.build.closing}
    </p>

    {c.demo.enabled && <DemoSlot c={c} />}
  </div>
</section>
