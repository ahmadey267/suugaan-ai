---
import type { SiteContent } from '../content/site';
import { currentPhase } from '../content/site';
import SectionHeading from './SectionHeading.astro';
import StatusPill from './StatusPill.astro';

interface Props {
  c: SiteContent;
  index: number;
}
const { c, index } = Astro.props;
const current = currentPhase(c);
const phases = c.roadmap.phases.map((p) => ({
  ...p,
  isCurrent: p.number === current.number,
  isReached: p.status === 'done' || p.number <= current.number,
}));
---

<section id="roadmap" aria-labelledby="roadmap-heading" class="section-pad bg-paper-2">
  <div class="container-page">
    <SectionHeading index={index} eyebrow={c.roadmap.eyebrow} heading={c.roadmap.heading} headingId="roadmap-heading" />

    <ol class="mt-14 grid lg:mt-20 lg:grid-cols-4 lg:gap-x-8">
      {
        phases.map((p, i) => {
          const isLast = i === phases.length - 1;
          const nextReached = !isLast && phases[i + 1].isReached;
          return (
            <li
              class="relative grid grid-cols-[1.5rem_1fr] gap-x-4 pb-10 lg:flex lg:flex-col lg:pb-0"
              aria-current={p.isCurrent ? 'step' : undefined}
              data-reveal
              style={`--reveal-i:${i}`}
            >
              {/* Track: vertical on mobile, horizontal on desktop */}
              {!isLast && (
                <span
                  aria-hidden="true"
                  class:list={[
                    'absolute top-6 bottom-0 left-[11.5px] lg:top-[11.5px] lg:right-[-2rem] lg:bottom-auto lg:left-6',
                    nextReached ? 'w-px bg-ink lg:h-px lg:w-auto' : 'w-px bg-line-strong lg:h-px lg:w-auto',
                  ]}
                />
              )}

              <span aria-hidden="true" class="relative z-10 flex size-6 items-center justify-center">
                {p.isCurrent ? (
                  <span class="size-3.5 rounded-full bg-gold ring-4 ring-paper-2" />
                ) : p.isReached ? (
                  <span class="size-2.5 rounded-full bg-ink ring-4 ring-paper-2" />
                ) : (
                  <span class="size-2.5 rounded-full border border-line-strong bg-paper-2 ring-4 ring-paper-2" />
                )}
              </span>

              <div class="lg:mt-6 lg:flex lg:grow lg:flex-col lg:pr-4">
                <p class="eyebrow text-muted">
                  {c.ui.phaseWord} {p.number}
                </p>
                <h3 class="mt-2 text-h3 font-medium">{p.name}</h3>
                <p class="mt-3 max-w-[40ch] text-small text-ink-2">{p.focus}</p>
                <p class="mt-4 lg:mt-auto lg:pt-5">
                  <StatusPill status={p.status} label={c.ui.statusLabels[p.status]} />
                </p>
              </div>
            </li>
          );
        })
      }
    </ol>

    <div class="mt-6 grid border-t border-line pt-6 lg:mt-16 lg:grid-cols-12 lg:gap-x-8" data-reveal>
      <p class="max-w-[56ch] text-ink lg:col-span-7 lg:col-start-6">{c.roadmap.note}</p>
    </div>
  </div>
</section>
