---
import type { SiteContent } from '../content/site';
import { currentPhase } from '../content/site';
import SectionHeading from './SectionHeading.astro';
import StatusPill from './StatusPill.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
const current = currentPhase(c);
---

<section id="roadmap" aria-labelledby="roadmap-heading" class="section-pad border-t border-line">
  <div class="container-page">
    <SectionHeading eyebrow={c.roadmap.eyebrow} heading={c.roadmap.heading} headingId="roadmap-heading" intro={c.roadmap.note} />

    <ol class="mt-14 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
      {
        c.roadmap.phases.map((p, i) => {
          const isCurrent = p.number === current.number;
          return (
            <li
              class:list={[
                'card flex min-h-[17rem] flex-col p-5 sm:p-6',
                isCurrent && 'border-gold/50! bg-[linear-gradient(180deg,rgb(201_162_39/0.10),transparent_60%)] shadow-[0_0_60px_-20px_rgb(201_162_39/0.45)]',
              ]}
              aria-current={isCurrent ? 'step' : undefined}
              data-reveal
              style={`--reveal-i:${i}`}
            >
              <div class="flex items-center justify-between gap-3">
                <span class="eyebrow text-muted">
                  {c.ui.phaseWord} {p.number}
                </span>
                <StatusPill status={p.status} label={c.ui.statusLabels[p.status]} />
              </div>
              <span aria-hidden="true" class:list={['mt-8 font-mono text-[3.5rem] leading-none tracking-[-0.06em] tabular-nums', isCurrent ? 'text-gold' : 'text-line-strong']}>
                0{p.number}
              </span>
              <h3 class="mt-auto pt-8 font-mono text-h3 font-medium">{p.name}</h3>
              <p class="mt-2 text-small text-fg-2">{p.focus}</p>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
