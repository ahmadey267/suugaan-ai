---
import type { SiteContent } from '../content/site';
import { currentPhase } from '../content/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
const current = currentPhase(c);
const phases = c.roadmap.phases;
---

<section id="roadmap" aria-labelledby="roadmap-heading" class="section bg-white">
  <div class="container-page">
    <SectionHeading heading={c.roadmap.heading} headingId="roadmap-heading" intro={c.roadmap.note} />

    <!-- A real sequence, so it is numbered and joined by a line. -->
    <ol class="relative mt-16 grid gap-12 lg:mt-24 lg:grid-cols-4 lg:gap-10">
      <span aria-hidden="true" class="absolute top-[11px] right-[12%] left-0 hidden h-px bg-line lg:block"></span>
      {
        phases.map((p) => {
          const isCurrent = p.number === current.number;
          const done = p.status === 'done';
          return (
            <li class="relative grid grid-cols-[1.5rem_1fr] gap-x-5 lg:block" aria-current={isCurrent ? 'step' : undefined}>
              <span aria-hidden="true" class="relative z-10 mt-1 flex size-6 items-center justify-center rounded-full bg-white lg:mt-0">
                <span class:list={['rounded-full', isCurrent ? 'size-3.5 bg-flag ring-4 ring-flag/20' : done ? 'size-3 bg-ink' : 'size-3 border border-field bg-white']} />
              </span>
              <div class="lg:mt-8">
                <p class:list={['text-small', isCurrent ? 'text-flag-ink' : 'text-muted']}>
                  {c.ui.phaseWord} {p.number}, {c.ui.statusLabels[p.status].toLowerCase()}
                </p>
                <h3 class="mt-2 text-[1.5rem] leading-tight font-light tracking-[-0.02em] text-ink">{p.name}</h3>
                <p class="mt-3 text-small text-ink-2">{p.focus}</p>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
