---
import type { SiteContent } from '../content/site';
import { currentPhase } from '../content/site';
import SectionHeading from './SectionHeading.astro';
import StatusPill from './StatusPill.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
const current = currentPhase(c);
const phases = c.roadmap.phases;
const phaseByNumber = new Map(phases.map((p) => [p.number, p]));
const rows = c.hero.labStatus.map((row) => ({
  label: row.label,
  phase: row.phase,
  status: phaseByNumber.get(row.phase)?.status ?? 'planned',
}));
---

<section id="roadmap" aria-labelledby="roadmap-heading" class="relative section-pad">
  <div class="aura-field" aria-hidden="true">
    <div class="aura aura-sky top-[35%] right-[-160px] h-[520px] w-[700px] opacity-45!"></div>
    <div class="aura aura-peach bottom-[0%] left-[-160px] h-[420px] w-[600px] opacity-45!"></div>
  </div>
  <div class="container-page relative">
    <SectionHeading eyebrow={c.roadmap.eyebrow} heading={c.roadmap.heading} headingId="roadmap-heading" intro={c.roadmap.note} />

    <div class="glass glass-edge mt-16 overflow-hidden lg:mt-24" data-reveal>
      <ol class="grid sm:grid-cols-2 lg:grid-cols-4">
        {
          phases.map((p, i) => {
            const isCurrent = p.number === current.number;
            return (
              <li
                class:list={[
                  'relative flex flex-col py-6 pr-6 first:pl-0 sm:pl-6 lg:min-h-[19rem] lg:py-8 lg:pr-8 lg:pl-8',
                  i > 0 && 'border-t border-line',
                  i === 1 && 'sm:border-t-0 sm:border-l',
                  i === 2 && 'lg:border-t-0 lg:border-l',
                  i === 3 && 'sm:border-l lg:border-t-0',
                  
                ]}
                aria-current={isCurrent ? 'step' : undefined}
              >
                <span aria-hidden="true" class:list={['absolute inset-x-0 top-0 h-1', isCurrent ? 'bg-[linear-gradient(90deg,#4189dd,#6a55d6,#d9a92a)]' : p.status === 'done' ? 'bg-sky' : 'bg-line']} />
                <div class="flex items-center justify-between gap-3">
                  <span class:list={['font-mono text-[0.75rem] tabular-nums', isCurrent ? 'text-sky-ink' : 'text-muted']}>
                    {c.ui.phaseWord} 0{p.number}
                  </span>
                  <StatusPill status={p.status} label={c.ui.statusLabels[p.status]} />
                </div>
                <span aria-hidden="true" class:list={['display mt-10 text-[4.5rem] leading-none tracking-[-0.06em]', isCurrent ? 'text-gradient' : 'text-[rgb(14_17_23/0.12)]']}>
                  {p.number}
                </span>
                <h3 class="display mt-auto pt-10 text-[1.5rem] leading-tight tracking-[-0.03em]">
                  <span class="sr-only">{c.ui.phaseWord} {p.number}. </span>
                  {p.name}
                </h3>
                <p class="mt-2 text-small text-fg-2">{p.focus}</p>
              </li>
            );
          })
        }
      </ol>

      <!-- Where each building block sits on the roadmap -->
      <div class="border-t border-line py-5">
        <p id="lab-status-heading" class="eyebrow text-muted">{c.ui.labStatus}</p>
        <ul class="mt-4 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-4" aria-labelledby="lab-status-heading">
          {
            rows.map((r) => (
              <li class="flex items-center justify-between gap-3 font-mono text-code">
                <span class="text-fg">{r.label}</span>
                <span class:list={['flex items-center gap-2', r.status === 'in-progress' ? 'text-sky-ink' : 'text-muted']}>
                  {c.ui.phaseWord.toLowerCase()} {r.phase}
                  <span aria-hidden="true">·</span>
                  {c.ui.statusLabels[r.status].toLowerCase()}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
