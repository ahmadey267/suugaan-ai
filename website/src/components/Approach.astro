---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
---

<section id="approach" aria-labelledby="approach-heading" class="section-pad border-t border-line">
  <div class="container-page">
    <SectionHeading eyebrow={c.approach.eyebrow} heading={c.approach.heading} headingId="approach-heading" />

    <ol class="mt-14 grid gap-4 md:grid-cols-3 lg:mt-16">
      {
        c.approach.principles.map((p, i) => (
          <li class="card flex min-h-[15rem] flex-col p-5 sm:p-6" data-reveal style={`--reveal-i:${i}`}>
            <span class="tag self-start" aria-hidden="true">{i + 1}</span>
            <h3 class="mt-auto pt-12 font-mono text-h3 font-medium">{p.title}</h3>
            <p class="mt-3 text-small text-fg-2">{p.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
