---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
---

<section id="approach" aria-labelledby="approach-heading" class="section-pad">
  <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-x-8">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-[calc(var(--header-h)+3rem)]">
        <SectionHeading eyebrow={c.approach.eyebrow} heading={c.approach.heading} headingId="approach-heading" />
      </div>
    </div>

    <ul class="lg:col-span-7 lg:col-start-6">
      {
        c.approach.principles.map((p, i) => (
          <li class="border-t border-line py-10 first:border-t-0 first:pt-0 lg:first:pt-2" data-reveal style={`--reveal-i:${i}`}>
            <h3 class="text-[clamp(1.75rem,1.3rem+1.9vw,2.75rem)] leading-[1.1] font-light tracking-[-0.02em] text-ink">
              {p.title}
            </h3>
            <p class="mt-4 max-w-[52ch] text-lead text-ink-2">{p.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
