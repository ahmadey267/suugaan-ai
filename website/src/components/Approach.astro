---
import type { SiteContent } from '../content/site';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
---

<section id="approach" aria-labelledby="approach-heading" class="section">
  <div class="container-page">
    <h2 id="approach-heading" class="text-h2 text-ink">{c.approach.heading}</h2>
    <div class="mt-14 flex flex-col gap-14 lg:mt-20 lg:gap-20">
      {
        c.approach.principles.map((p) => (
          <div class="grid gap-4 lg:grid-cols-12 lg:gap-x-10">
            <h3 class="text-[clamp(1.75rem,1.3rem+1.6vw,2.625rem)] leading-[1.1] font-light tracking-[-0.025em] text-ink lg:col-span-5">{p.title}</h3>
            <p class="max-w-[36rem] text-lead text-ink-2 lg:col-span-6 lg:col-start-7 lg:pt-2">{p.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
