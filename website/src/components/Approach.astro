---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
---

<section id="approach" aria-labelledby="approach-heading">
  <div class="container-page">
    <div class="frame frame-top frame-pad section-pad pb-14! lg:pb-20!">
      <SectionHeading index="03" eyebrow={c.approach.eyebrow} heading={c.approach.heading} headingId="approach-heading" />
    </div>
    <ul class="frame grid border-t border-line md:grid-cols-3">
      {
        c.approach.principles.map((p, i) => (
          <li class:list={['flex flex-col py-8 md:px-6 md:py-10 lg:px-8', i > 0 && 'border-t border-line md:border-t-0 md:border-l']} data-reveal style={`--reveal-i:${i}`}>
            <h3 class="mono-heading text-[clamp(1.375rem,1.1rem+1vw,1.875rem)] leading-tight tracking-[-0.035em]">{p.title}</h3>
            <p class="mt-5 text-fg-2">{p.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
