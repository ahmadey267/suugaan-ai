---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  c: SiteContent;
  index: number;
}
const { c, index } = Astro.props;
---

<section id="approach" aria-labelledby="approach-heading" class="section-pad pt-0!">
  <div class="container-page">
    <div class="grid gap-10 border-t border-line pt-6 lg:grid-cols-12 lg:gap-x-8">
      <div class="lg:col-span-4">
        <SectionHeading index={index} eyebrow={c.approach.eyebrow} heading={c.approach.heading} headingId="approach-heading" />
      </div>

      <ol class="border-b border-line lg:col-span-7 lg:col-start-6 lg:mt-[54px]">
        {
          c.approach.principles.map((p, i) => (
            <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 border-t border-line py-8 first:border-t-0 first:pt-0 lg:first:border-t lg:first:pt-8" data-reveal style={`--reveal-i:${i}`}>
              <span class="eyebrow pt-1.5 text-muted" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-h3 font-medium">{p.title}</h3>
                <p class="mt-3 max-w-[56ch]">{p.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
