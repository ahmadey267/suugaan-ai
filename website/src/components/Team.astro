---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
const initials = (name: string) =>
  name
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0])
    .join('');
---

<section id="team" aria-labelledby="team-heading" class="section-pad border-t border-line">
  <div class="container-page">
    <SectionHeading eyebrow={c.team.eyebrow} heading={c.team.heading} headingId="team-heading" />

    <ul class="mt-14 grid gap-4 md:grid-cols-2 lg:mt-16">
      {
        c.team.founders.map((f, i) => (
          <li class="card flex flex-col gap-6 p-5 sm:flex-row sm:p-6" data-reveal style={`--reveal-i:${i}`}>
            {f.photo ? (
              <img src={f.photo} alt={f.name} width="320" height="400" loading="lazy" decoding="async" class="aspect-[4/5] w-32 shrink-0 rounded-md object-cover sm:w-40" />
            ) : (
              <div class="flex aspect-[4/5] w-32 shrink-0 flex-col justify-between rounded-md border border-line bg-bg p-3 sm:w-40" data-placeholder="founder-photo">
                <span aria-hidden="true" class="font-mono text-[2.5rem] leading-none tracking-[-0.06em] text-gold">{initials(f.name)}</span>
                <span class="font-mono text-[0.625rem] tracking-[0.06em] text-muted uppercase">{c.ui.photoPlaceholder}</span>
              </div>
            )}
            <div>
              <h3 class="font-mono text-[1.25rem] leading-snug font-medium tracking-[-0.02em]">{f.name}</h3>
              <p class="eyebrow mt-2 text-gold">{f.role}</p>
              <p class="mt-4 text-small text-fg-2">{f.bio}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 max-w-[64ch] text-fg-2" data-reveal>{c.team.note}</p>
  </div>
</section>
