---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
const initials = (name: string) => name.split(' ').filter(Boolean).slice(0, 2).map((w) => w[0]).join('');
---

<section id="team" aria-labelledby="team-heading" class="section bg-white">
  <div class="container-page">
    <SectionHeading heading={c.team.heading} headingId="team-heading" intro={c.team.note} />
    <ul class="mt-16 grid gap-14 md:grid-cols-2 md:gap-10 lg:mt-24">
      {
        c.team.founders.map((f) => (
          <li class="grid gap-6 sm:grid-cols-[9rem_1fr] sm:gap-8">
            {f.photo ? (
              <img src={f.photo} alt={f.name} width="288" height="360" loading="lazy" decoding="async" class="aspect-[4/5] w-36 object-cover" />
            ) : (
              <div class="flex aspect-[4/5] w-36 flex-col justify-between bg-paper p-3" data-placeholder="founder-photo">
                <span aria-hidden="true" class="text-[2.25rem] leading-none font-light tracking-[-0.03em] text-muted">{initials(f.name)}</span>
                <span class="text-[0.75rem] text-muted">{c.ui.photoPlaceholder}</span>
              </div>
            )}
            <div>
              <h3 class="text-[1.5rem] leading-tight font-light tracking-[-0.02em] text-ink">{f.name}</h3>
              <p class="mt-1 text-small text-muted">{f.role}</p>
              <p class="mt-4 text-ink-2">{f.bio}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
