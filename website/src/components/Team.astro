---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  c: SiteContent;
}
const { c } = Astro.props;
const initials = (name: string) =>
  name
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0])
    .join('');
---

<section id="team" aria-labelledby="team-heading">
  <div class="container-page">
    <div class="frame frame-top frame-pad section-pad pb-14! lg:pb-20!">
      <SectionHeading index="06" eyebrow={c.team.eyebrow} heading={c.team.heading} headingId="team-heading" />
    </div>
    <ul class="frame grid border-t border-line md:grid-cols-2">
      {
        c.team.founders.map((f, i) => (
          <li class:list={['flex gap-5 py-8 md:px-6 lg:gap-8 lg:px-8 lg:py-10', i > 0 && 'border-t border-line md:border-t-0 md:border-l']} data-reveal style={`--reveal-i:${i}`}>
            {f.photo ? (
              <img src={f.photo} alt={f.name} width="240" height="300" loading="lazy" decoding="async" class="aspect-[4/5] w-24 shrink-0 object-cover sm:w-32" />
            ) : (
              <div class="flex aspect-[4/5] w-24 shrink-0 flex-col justify-between border border-line bg-surface p-2.5 sm:w-32" data-placeholder="founder-photo">
                <span aria-hidden="true" class="font-mono text-[2rem] leading-none tracking-[-0.06em] text-gold">{initials(f.name)}</span>
                <span class="font-mono text-[0.5625rem] leading-tight tracking-[0.06em] text-muted uppercase">{c.ui.photoPlaceholder}</span>
              </div>
            )}
            <div class="min-w-0">
              <h3 class="font-mono text-[1.25rem] leading-snug font-medium tracking-[-0.03em]">{f.name}</h3>
              <p class="eyebrow mt-1.5 text-gold">{f.role}</p>
              <p class="mt-4 text-small text-fg-2">{f.bio}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <div class="frame frame-pad border-t border-line py-8" data-reveal>
      <p class="max-w-[64ch] text-small text-fg-2">{c.team.note}</p>
    </div>
  </div>
</section>
